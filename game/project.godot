; Engine configuration file.
; It's best edited using the editor UNLESS you know what you're doing.

config_version=5

[application]

config/name="Infinite Drive"
config/description="Endless procedural asphalt driving game for Android (Godot 4)"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://icon.svg"

[autoload]

SaveSystem="*res://savesystem/save_system.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

sensors/enable_gravity=true
sensors/enable_accelerometer=true

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8
common/physics_interpolation=true
3d/default_gravity=9.8

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
